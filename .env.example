# Uses OpenAI when OPENAI_API_KEY and the model for the selected deployment mode are set; deterministic otherwise.
# Set deterministic explicitly to disable model calls.
RESEARCHPILOT_PROVIDER=auto
# Deployment modes: Full (default), Limited, Restricted.
RESEARCHPILOT_MODE=Full
OPENAI_API_KEY=
# Direct provider request defaults; deployment routing applies the mode timeouts.
RESEARCHPILOT_PLANNING_TIMEOUT_SECONDS=300
RESEARCHPILOT_CODE_TIMEOUT_SECONDS=300
# Full requires RESEARCHPILOT_STRONG_MODEL and uses it for every stage.
# Limited requires both models; Restricted requires only RESEARCHPILOT_WEAK_MODEL.
# Replace the empty values with explicit provider model names, then restart the backend/workers.
RESEARCHPILOT_STRONG_MODEL=
RESEARCHPILOT_WEAK_MODEL=
RESEARCHPILOT_LIMITED_ROUTINE_MODEL=
RESEARCHPILOT_LIMITED_SYNTHESIS_MODEL=
RESEARCHPILOT_LIMITED_MAX_PAPERS=5
RESEARCHPILOT_LIMITED_MAX_PAPER_BYTES=10000000
RESEARCHPILOT_LIMITED_MAX_PAPER_PAGES=40
RESEARCHPILOT_LIMITED_MAX_STEPS=10
RESEARCHPILOT_LIMITED_MAX_TOOLS=6
RESEARCHPILOT_LIMITED_MAX_EXPERIMENTS=1
RESEARCHPILOT_LIMITED_MAX_EXPERIMENT_SECONDS=60
RESEARCHPILOT_LIMITED_MAX_CODE_CHARS=20000
RESEARCHPILOT_LIMITED_MAX_REPETITIONS=5
RESEARCHPILOT_LIMITED_MAX_OUTPUT_TOKENS=2500
RESEARCHPILOT_LIMITED_MAX_RUN_TOKENS=50000
RESEARCHPILOT_LIMITED_MAX_COST_USD=0.05
RESEARCHPILOT_LIMITED_RUNS_PER_DAY=2
RESEARCHPILOT_LIMITED_CACHE_TTL_SECONDS=86400
RESEARCHPILOT_LIMITED_CACHE_VERSION=v1

RESEARCHPILOT_PRICE_TABLE=prices.json
RESEARCHPILOT_WORKSPACE=.researchpilot
RESEARCHPILOT_WORKERS=4
RESEARCHPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional service token. Prefer an authenticated TLS gateway for shared deployments.
RESEARCHPILOT_API_TOKEN=

# Execution: local for trusted development, docker for untrusted generated code.
RESEARCHPILOT_EXECUTOR=local
RESEARCHPILOT_DOCKER_IMAGE=python:3.13-slim
# Docker images must already be present; execution never pulls images implicitly.

# Optional local semantic model; weights must already exist locally.
RESEARCHPILOT_EMBEDDINGS=hash
# RESEARCHPILOT_EMBEDDINGS=sentence-transformer
# RESEARCHPILOT_EMBEDDING_MODEL=C:/models/my-embedding-model
# RESEARCHPILOT_EMBEDDING_REVISION=explicit-model-revision
RESEARCHPILOT_PAPER_HOSTS=arxiv.org,export.arxiv.org,pmc.ncbi.nlm.nih.gov

# Optional isolated API workspaces and reader/researcher roles. Requires docker.
# RESEARCHPILOT_IDENTITIES_FILE=C:/path/to/identities.json
# Optional issuer-signed JWT access tokens mapped to local subjects and roles.
# RESEARCHPILOT_OIDC_ISSUER=https://identity.example/issuer
# RESEARCHPILOT_OIDC_AUDIENCE=researchpilot-api
# RESEARCHPILOT_OIDC_JWKS_URL=https://identity.example/issuer/jwks

# Opt-in operational telemetry (no prompts or paper contents).
RESEARCHPILOT_OTEL=0
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Restricted has the same bounded defaults as Limited. Optional overrides:
# RESEARCHPILOT_RESTRICTED_MAX_STEPS=10
# RESEARCHPILOT_RESTRICTED_MAX_OUTPUT_TOKENS=2500
# RESEARCHPILOT_RESTRICTED_MAX_COST_USD=0.05
